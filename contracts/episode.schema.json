{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "startScene",
    "evidence",
    "scenes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "startScene": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "target",
                "requiresEvidence",
                "effects"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "requiresEvidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  }
                },
                "effects": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence",
                    "trustDelta"
                  ],
                  "properties": {
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                      }
                    },
                    "trustDelta": {
                      "type": "integer",
                      "minimum": -5,
                      "maximum": 5
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
