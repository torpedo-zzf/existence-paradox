# Optional future integrations only. No credentials required for Phase 0 or 1.
ENABLE_PAID_GENERATION=false
DIALOGUE_PROVIDER=mock
# No provider URLs or keys assumed. Configure verified adapters after approval.

# Future server-only DeepSeek configuration; blank and disabled intentionally.
ENABLE_DEEPSEEK_RUNTIME=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
DEEPSEEK_SESSION_COST_CAP=
# Never put these values into client bundles, logs, or task files.

# Metaso is the selected MiniMax-H3 API provider; local production only.
ENABLE_METASO_VIDEO=false
METASO_BASE_URL=https://metaso.cn/api/minimax
METASO_VIDEO_MODEL=MiniMax-H3
METASO_API_KEY=
METASO_BATCH_BUDGET_CNY=
METASO_MAX_ATTEMPTS=

# Private OSS staging; no credential or bucket assumed.
ENABLE_OSS_UPLOAD=false
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_SIGNED_GET_TTL_SECONDS=7200
OSS_STAGING_PREFIX=staging/existence-paradox/

# Suno MCP: owner OAuth in verified client; no token in repo or env needed.
ENABLE_SUNO_MCP=false
SUNO_MCP_URL=https://api.suno.com/mcp
SUNO_CREDIT_BUDGET=
SUNO_DOWNLOAD_BUDGET=
# Suno REST and third-party APIs are outside this baseline.
